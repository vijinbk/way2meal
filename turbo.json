{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [".next/types/**"]
    },
    "test:unit": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DOCKER_HOST", "TESTCONTAINERS_*"],
      "passThroughEnv": ["DOCKER_HOST", "TESTCONTAINERS_*", "HOME"]
    },
    "bundle:android": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    }
  }
}
