{
  "name": "way2meal",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres minio",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @way2meal/api prisma:migrate",
    "db:seed": "pnpm --filter @way2meal/api prisma:seed",
    "dev:api": "pnpm --filter @way2meal/api dev",
    "dev:admin": "pnpm --filter @way2meal/admin dev",
    "dev:mobile": "pnpm --filter @way2meal/mobile start"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
