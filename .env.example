# Copy to apps/api/.env for local development.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://way2meal:way2meal@localhost:5432/way2meal?schema=public

# Auth — use long random strings outside local dev (e.g. `openssl rand -hex 32`).
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_HMAC_SECRET=change-me-otp

# OTP policy
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_COUNT=3
OTP_RATE_LIMIT_WINDOW_SECONDS=600
# Fixed OTP for non-production only (rejected when NODE_ENV=production).
DEV_OTP=123456

# Phase 1 providers (only these exist now)
OTP_PROVIDER=mock
PAYMENT_PROVIDER=manual

# Seed: phone that becomes the first ADMIN user
SEED_ADMIN_PHONE=+919999999999

# S3-compatible storage (MinIO locally) — used from M3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=way2meal
S3_ACCESS_KEY=way2meal
S3_SECRET_KEY=way2meal-secret
